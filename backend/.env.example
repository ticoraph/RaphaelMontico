# Postgres reachable from the host (e.g. via `docker compose up -d postgres`).
# docker-compose.yml overrides this to the in-network hostname when running
# the api service itself through compose.
DATABASE_URL=postgresql://backend:backend@localhost:5432/backend

# Chat (LLM_PROVIDER=openai, défaut).
OPENAI_API_KEY=
# Embeddings (et chat si LLM_PROVIDER=gemini).
GEMINI_API_KEY=

# Fournisseur du chatbot : openai (défaut) ou gemini. Les embeddings restent sur Gemini.
LLM_PROVIDER=openai

# Langfuse observability (https://langfuse.com)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Comma-separated list of origins allowed to call this API (the frontend's
# CloudFront domain in prod, http://localhost:3000 for local frontend dev).
ALLOWED_ORIGINS=http://localhost:3000

# Public-API hardening — defaults shown, see backend/README.md.
# Reverse proxies in front of the API appending to X-Forwarded-For (App Runner = 1).
# TRUSTED_PROXY_HOPS=1
# Serve /docs, /redoc and /openapi.json (local development only).
# ENABLE_DOCS=true

# Defaults shown — override only if you need to change them.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
OPENAI_CHAT_MODEL=gpt-6-luna
